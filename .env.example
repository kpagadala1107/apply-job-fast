# Copy this file to .env and fill in your keys

# ── Supabase (required for persistence) ───────────────────────────────────────
# 1. Create a project at https://supabase.com
# 2. Run supabase/schema.sql in the SQL Editor
# 3. Enable Anonymous Auth: Authentication → Providers → Anonymous → Enable
# Project URL and anon key are in: Settings → API
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Job Data (pick one) ────────────────────────────────────────────────────────

# Option 1: JSearch via RapidAPI (recommended — aggregates LinkedIn + Indeed + Glassdoor)
# Sign up: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Free tier: 200 requests/month
VITE_RAPIDAPI_KEY=

# Option 2: Adzuna (alternative free tier)
# Sign up: https://developer.adzuna.com
VITE_ADZUNA_APP_ID=
VITE_ADZUNA_APP_KEY=

# ── LinkedIn OAuth (user profile auth — NOT job search) ───────────────────────
# Sign up: https://www.linkedin.com/developers/apps
# Scopes needed: openid profile email
# Add redirect URI: http://localhost:5173/auth/linkedin/callback
VITE_LINKEDIN_CLIENT_ID=

# ── AI Resume Analysis ────────────────────────────────────────────────────────
# Sign up: https://platform.openai.com
VITE_OPENAI_API_KEY=
